<!DOCTYPE html>
<html>
<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="text-dark">Create a New Post</h1>
      <form action="/newpost" method="POST">
        <div class="mb-3">
          <input type="text" name="title" class="form-control" placeholder="Title">
        </div>
        <div class="mb-3">
          <textarea name="content" class="form-control" rows="6" placeholder="Write something"></textarea>
        </div>
        <div class="mb-3">
  <input type="text" name="image" class="form-control" placeholder="Image URL (optional)">
</div>
        <button type="submit" class="btn btn-primary w-100">Post</button>
        <a href="/" class="btn btn-secondary w-100 mt-2">Cancel</a>
     
      </form>
    </div>
  </div>
</div>

</body>
</html>