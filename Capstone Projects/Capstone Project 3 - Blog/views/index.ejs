<!DOCTYPE html>
<html>
<head>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>

<div class="container">
  <header class="border-bottom py-3 text-center">
    <h1 class="blog-header-logo">Good Vibes & Good Food</h1>
    <a href="/newpost" class="btn btn-primary">New Post</a>
  </header>

  <main class="container mt-4">
    <div class="row justify-content-center">
      <div class="col-md-8">

        <% blogPosts.forEach((post) => { %>
          <article class="blog-post border-bottom mb-4 pb-4">

            <h2><%= post.title %></h2>

            <% if (post.image) { %>
              <img 
                src="<%= post.image %>" 
                class="img-fluid mb-3" 
                alt="Blog image">
            <% } %>

            <div><%- marked(post.content) %></div>

            <div class="mt-3">
              <a href="/edit/<%= post.id %>" class="btn btn-warning btn-sm">
                Edit
              </a>

              <form action="/delete/<%= post.id %>" method="POST" style="display:inline;">
                <button type="submit" class="btn btn-danger btn-sm">
                  Delete
                </button>
              </form>
            </div>

          </article>
        <% }) %>

      </div>
    </div>
  </main>

  <footer class="py-5 text-center text-muted">
    <p>Good Vibes & Good Food © <%= new Date().getFullYear() %></p>
  </footer>
</div>

</body>
</html>